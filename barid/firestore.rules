rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null && request.auth.token.email_verified == true; }
    function myEmail() { return request.auth.token.email.lower(); }
    function isOwner() { return signedIn() && request.auth.token.email == 'maanyaseen94@gmail.com'; }
    function staffDoc() { return get(/databases/$(database)/documents/staff/$(myEmail())); }
    function hasPerm(p) {
      return signedIn() && exists(/databases/$(database)/documents/staff/$(myEmail()))
        && staffDoc().data.get('perms', {}).get(p, false) == true;
    }
    function canMail() { return isOwner() || hasPerm('mail'); }
    function canActs() { return isOwner() || hasPerm('acts'); }
    function canPress() { return isOwner() || hasPerm('press'); }

    match /staff/{email} {
      allow read: if isOwner() || (signedIn() && myEmail() == email);
      allow write: if isOwner();
    }
    match /public/{key} {
      allow get: if true;
      allow list: if false;
      allow write: if canMail();
    }
    match /letters/{id} {
      allow read, write: if canMail();
    }
    match /images/{id} {
      allow get: if true;
      allow list: if false;
      allow write: if canMail();
    }
    match /activities/{id} {
      allow read: if true;
      allow write: if canActs();
    }
    match /press/{id} {
      allow read: if true;
      allow write: if canPress();
    }
  }
}
