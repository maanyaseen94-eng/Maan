rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() { return request.auth != null && request.auth.token.email_verified == true; }
    function isOwner() { return signedIn() && request.auth.token.email == 'maanyaseen94@gmail.com'; }
    function isStaff() {
      return isOwner() || (signedIn() &&
        exists(/databases/$(database)/documents/staff/$(request.auth.token.email.lower())));
    }
    // قائمة الموظفين المخوّلين — يديرها المسؤول فقط
    match /staff/{email} {
      allow read: if isStaff() || (signedIn() && request.auth.token.email.lower() == email);
      allow write: if isOwner();
    }
    // ملخص عام لكل مواطن: يُقرأ فقط برمز البحث (الاسم أو الهاتف)، ولا يمكن تصفّح القائمة
    match /public/{key} {
      allow get: if true;
      allow list: if false;
      allow write: if isStaff();
    }
    // الكتب الكاملة للموظفين فقط
    match /letters/{id} {
      allow read, write: if isStaff();
    }
    // صور الكتب: تُفتح فقط برمزها العشوائي الموجود في نتيجة البحث
    match /images/{id} {
      allow get: if true;
      allow list: if false;
      allow write: if isStaff();
    }
    // النشاطات يراها الجميع
    match /activities/{id} {
      allow read: if true;
      allow write: if isStaff();
    }
  }
}
